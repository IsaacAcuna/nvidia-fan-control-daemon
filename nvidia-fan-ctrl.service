[Unit]
Description=NVIDIA GPU fan curve
After=nvidia-persistenced.service
Wants=nvidia-persistenced.service

[Service]
Type=simple
EnvironmentFile=/etc/default/nvidia-fan-ctrl
ExecStart=/usr/local/sbin/nvidia-fan-ctrl
Restart=always
RestartSec=5
# Exit code 78 means bad config; restarting won't fix that.
RestartPreventExitStatus=78

[Install]
WantedBy=multi-user.target
